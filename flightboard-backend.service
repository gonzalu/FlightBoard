[Unit]
Description=FlightBoard backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- EDIT THESE ----------------------------------------------------------
# The account that owns the checkout, where you cloned it, and your location.
User=CHANGEME
WorkingDirectory=/home/CHANGEME/flightboard
Environment=FLIGHTBOARD_HOME_LAT=0.0
Environment=FLIGHTBOARD_HOME_LON=0.0

# One or more receivers, comma separated. All are polled and merged, so a
# second receiver widens coverage and covers the first one dropping out.
# tar1090 users: the path is usually /tar1090/data/aircraft.json
Environment=FLIGHTBOARD_RECEIVERS=http://YOUR-PI.local/skyaware/data/aircraft.json
Environment=FLIGHTBOARD_MAX_RANGE_NM=40

ExecStart=/home/CHANGEME/flightboard/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8090
# --------------------------------------------------------------------------

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
