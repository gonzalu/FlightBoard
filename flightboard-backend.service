[Unit]
Description=FlightBoard backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- EDIT THESE ----------------------------------------------------------
# The account that owns the checkout, and where you cloned it. Three paths to
# change; there is nothing else to fill in here.
User=CHANGEME
WorkingDirectory=/home/CHANGEME/flightboard

# Your coordinates and receivers live in flightboard.env, not in this file, so
# that a manual `uvicorn` run and this service read the same settings. Copy
# flightboard.env.example to flightboard.env and edit that. The leading dash
# means the service still starts if the file is missing.
EnvironmentFile=-/home/CHANGEME/flightboard/flightboard.env

ExecStart=/home/CHANGEME/flightboard/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8090
# --------------------------------------------------------------------------

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
