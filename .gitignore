.venv/
__pycache__/
*.pyc

# Generated locally by tools/make_logos.py from airline logo artwork.
# Trademarked images - keep them out of a public repo.
frontend/logos.js

# Hand-picked logo artwork (e.g. an airline's own dark-background lockup).
# Same trademark reasoning as logos.js - keep the images out of the repo.
logo-sources/

# Logo source artwork, if extracted into the checkout rather than /tmp
airline-logos-main/

# Your settings, including your coordinates. Copy flightboard.env.example.
flightboard.env

# Which aircraft you hide. Copy filters.example.json.
filters.json

# Standing data - routes, airframes, types - rebuilt by
# tools/fetch_standing_data.py. About 31 MB, and regenerable.
data/

# Your coastline and airports, generated for your home by
# tools/make_basemap.py. Specific to one location.
frontend/basemap.js
