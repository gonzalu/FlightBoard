# FlightBoard settings. Copy this file to flightboard.env and edit it:
#
#     cp flightboard.env.example flightboard.env
#
# It is read both by a manual `uvicorn` run and by the systemd unit, so this is
# the one place to write your settings down. flightboard.env is gitignored,
# because it holds your location.
#
# Anything already set in the environment overrides this file, so you can try a
# one-off change without editing here:
#
#     FLIGHTBOARD_MAX_AIRCRAFT=200 .venv/bin/uvicorn backend.main:app

# --- the two that matter -----------------------------------------------------

# Your location. A few decimal places off any map is plenty. Everything is
# filtered by distance from here, so if this is wrong the board stays empty.
FLIGHTBOARD_HOME_LAT=40.8834
FLIGHTBOARD_HOME_LON=-73.9103

# One or more receivers, comma separated. All are polled and merged, so a
# second receiver widens coverage and covers the first one dropping out.
#   piaware / dump1090-fa   /skyaware/data/aircraft.json
#   tar1090                 /tar1090/data/aircraft.json
#   readsb / dump1090       /data/aircraft.json
FLIGHTBOARD_RECEIVERS=http://YOUR-PI.local/skyaware/data/aircraft.json

# How far out to look is NOT here: it lives in filters.json as range_nm,
# beside the altitude band, because that file is re-read while running.

# --- everything below is optional; the defaults are shown ---------------------

#FLIGHTBOARD_LOCAL_AIRPORT_NM=30    # an airport this close counts as "local"
#FLIGHTBOARD_MAX_AIRCRAFT=60        # cap on how many the API returns
#FLIGHTBOARD_POLL_INTERVAL=2        # seconds between receiver polls
#FLIGHTBOARD_ENABLE_ENRICH=1        # 0 disables adsbdb lookups, fully offline
#FLIGHTBOARD_ENRICH_TTL=3600        # seconds to cache an airline/route lookup
#FLIGHTBOARD_ENRICH_FAIL_TTL=300    # ...and to cache one that found nothing
#FLIGHTBOARD_DEBUG=0                # 1 shows the diagnostic bands on every display
#FLIGHTBOARD_PORT=8090
